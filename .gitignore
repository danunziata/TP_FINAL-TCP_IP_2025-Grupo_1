# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Caché y compilados de Python
__pycache__/
*.py[cod]
*.pyo
.Python/

# Archivos de entorno virtual
venv/
.venv/
env/
.env/
*.env # Ignorar cualquier archivo .env para configuraciones locales

# ####################################################################
# SE RECOMIENDA NO IGNORAR LOS SIGUIENTES ARCHIVOS JSON.
# Son necesarios para el primer arranque de la aplicación.
# En su lugar, se debe hacer commit de una versión inicial vacía de ellos.
# Por ejemplo: logs_alertas.json con el contenido "[]".
#
# Streamlit/logs_alertas.json
# Streamlit/last_digest_sent_state.json
# Streamlit/pending_alerts_buffer.json
# Streamlit/reset_tokens.json
# ####################################################################

# Archivos obsoletos que deberían ser eliminados del repositorio
# Si alert_cooldown_state.json y umbral_config.json siguen en el repo,
# elimínalos con 'git rm --cached <archivo>' y luego haz commit.
Streamlit/alert_cooldown_state.json
Streamlit/umbral_config.json

# Archivos de caché de Streamlit
.streamlit/

# Archivos de instalación y paquetes temporales de Python
*.egg-info/
.coverage
.pytest_cache/
htmlcov/
build/
dist/

# Archivos de backup, temporales, comprimidos
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.bak
*~ # Archivos de backup de editores como Vim
*.swp # Archivos swap de Vim

# Archivos de bases de datos locales o de desarrollo
*.sqlite3
*.db

# Directorios específicos de IDEs
.idea/ # IntelliJ IDEA
.vscode/ # Visual Studio Code
.project
.classpath
.settings/

# Directorios de pruebas y backups
# Se ignora la carpeta completa para mantener el repositorio limpio.
Pruebas18Jun/
