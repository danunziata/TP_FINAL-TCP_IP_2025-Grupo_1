# Archivos del sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Caché y compilados de Python
__pycache__/
*.py[cod]
*.pyo
.Python/

# Archivos de entorno virtual
venv/
.venv/
env/
.env/
*.env # Ignorar cualquier archivo .env para configuraciones locales

# Archivos de logs y estado generados por la aplicación
# Ahora que los archivos están en la raíz, las rutas son más cortas:
Streamlit/logs_alertas.json
Streamlit/last_digest_sent_state.json
Streamlit/pending_alerts_buffer.json
Streamlit/reset_tokens.json
# Si alert_cooldown_state.json se regenerara por alguna razón (debería estar eliminado):
Streamlit/alert_cooldown_state.json
# Si umbral_config.json aún existiera y no fuera eliminado:
Streamlit/umbral_config.json

# Archivos de caché de Streamlit
.streamlit/

# Archivos de instalación y paquetes temporales de Python
*.egg-info/
.coverage
.pytest_cache/
htmlcov/
build/
dist/

# Archivos de backup, temporales, comprimidos
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.bak
*~ # Archivos de backup de editores como Vim
*.swp # Archivos swap de Vim

# Archivos de bases de datos locales o de desarrollo
*.sqlite3
*.db

# Directorios específicos de IDEs
.idea/ # IntelliJ IDEA
.vscode/ # Visual Studio Code
.project
.classpath
.settings/

# Directorios de pruebas antiguos o de backups que has movido/limpiado
# Puedes eliminar o mantener estas líneas dependiendo de si quieres seguir rastreando Pruebas18Jun/
# Si quieres eliminar completamente la carpeta Pruebas18Jun/ del repositorio:
Pruebas18Jun/
# Si solo quieres ignorar su contenido pero mantener la carpeta Pruebas18Jun/ sin rastrear sus archivos:
# Pruebas18Jun/backups/
# Pruebas18Jun/Last_Release/
# Pruebas18Jun/README.md